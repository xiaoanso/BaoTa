"""七牛云 SSL 授权部署插件（stdin/stdout JSON，对齐 deploy_plugin 协议）"""
from __future__ import annotations

import base64
import datetime
import hashlib
import hmac
import json
import sys
from typing import Any, Dict, Optional, Tuple
from urllib.parse import urlparse

import requests

PLUGIN_NAME = "qiniu"
PLUGIN_VERSION = "1.0.0"
API_HOST = "http://api.qiniu.com"


def ok(message: str = "", result: Optional[dict] = None) -> Dict[str, Any]:
    return {"status": "success", "message": message or "ok", "result": result or {}}


def err(message: str, result: Optional[dict] = None) -> Dict[str, Any]:
    return {"status": "error", "message": message or "error", "result": result or {}}


def _bool(v: Any, default: bool = False) -> bool:
    if v is None:
        return default
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return bool(v)
    s = str(v).strip().lower()
    if s in ("1", "true", "yes", "on"):
        return True
    if s in ("0", "false", "no", "off", ""):
        return False
    return default


def qbox_token(access_key: str, secret_key: str, url: str, method: str = "GET", body: bytes = b"") -> str:
    """QBox 鉴权：对 path[+query] 与 body 签名（与官方 SDK 一致）。"""
    u = urlparse(url)
    path = u.path or "/"
    data = path
    if u.query:
        data += "?" + u.query
    data += "\n"
    if body and method.upper() in ("POST", "PUT", "PATCH"):
        # 证书/域名 JSON 接口多为 Content-Type: application/json，签名不含 body；
        # 与博客脚本 / DomainManager 一致，仅签 path。
        pass
    sign = hmac.new(secret_key.encode("utf-8"), data.encode("utf-8"), hashlib.sha1).digest()
    encoded = base64.urlsafe_b64encode(sign).decode("utf-8")
    return "{}:{}".format(access_key, encoded)


def api_request(
    access_key: str,
    secret_key: str,
    method: str,
    path: str,
    payload: Optional[dict] = None,
    timeout: int = 30,
) -> Tuple[Any, int, str]:
    url = API_HOST.rstrip("/") + path
    body = b""
    headers = {"Content-Type": "application/json"}
    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
    token = qbox_token(access_key, secret_key, url, method=method, body=body)
    headers["Authorization"] = "QBox " + token
    resp = requests.request(method.upper(), url, data=body if payload is not None else None, headers=headers, timeout=timeout)
    text = resp.text or ""
    try:
        data = resp.json() if text else {}
    except Exception:
        data = {"raw": text}
    return data, resp.status_code, text


def require_keys(params: dict) -> Tuple[Optional[str], Optional[str], Optional[str]]:
    ak = (params.get("access_key") or params.get("access_key_id") or "").strip()
    sk = (params.get("secret_key") or params.get("access_key_secret") or "").strip()
    if not ak or not sk:
        return None, None, "缺少 access_key / secret_key"
    return ak, sk, None


